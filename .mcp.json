{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.78"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.6.0",
        "--chromeArg=--disable-features=PasswordLeakDetection,PasswordCheck",
        "--chromeArg=--no-default-browser-check",
        "--chromeArg=--disable-sync"
      ]
    }
  }
}
